{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MirrorDock",
  "version": "0.2.6",
  "identifier": "com.mirrordock.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && bash scripts/prepare-runtime.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MirrorDock",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
