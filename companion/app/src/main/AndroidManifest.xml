<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34 起媒体投影前台服务必须声明专用类型与权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- M4-2 常驻连接前台服务（dataSync 类型）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 读取「下载/MirrorDock」里电脑推送的文件：API ≤ 32 走运行时权限。 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- API 30+ 看到并打开电脑推送文件的现实路径：由用户在系统设置里授予所有文件访问。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 再次安装电脑发来的 APK：仍需用户逐次确认，不经用户同意装不了。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- TV 模式（X10-28）：声明支持 Android TV（leanback），但手机仍照常安装；
         电视没有触屏，touchscreen 也不能声明为必需，否则电视上装不上。 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.Companion"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 电视桌面入口：同一 Activity，电视启动器用 banner 展示。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 扫码页：仅应用内部启动；缺失声明会导致 ActivityNotFoundException 闪退。 -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- M4-2 常驻连接：凭本地互信凭据免扫码直连已配对电脑。 -->
        <service
            android:name=".PersistentConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- X10-66 通知镜像：系统绑定式服务（BIND_NOTIFICATION_LISTENER_SERVICE
             由系统持有，应用侧无法伪造）；用户在系统设置显式授权读取通知，
             应用内开关默认关，可随时关。 -->
        <service
            android:name=".NotificationMirrorService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 只共享「下载/MirrorDock」里的电脑推送文件，供查看与 APK 安装使用。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
