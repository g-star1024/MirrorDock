<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Companion" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorAccent">@color/brand_blue</item>
    </style>

    <style name="PrimaryButton">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="SecondaryButton">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>
</resources>
