<?xml version="1.0" encoding="utf-8"?>
<!-- 按钮与卡片样式（X10-73 重构）；主题本体在 themes.xml（两者不重复定义）。 -->
<resources>
    <!-- 主 CTA：品牌青碧实心胶囊。stateListAnimator 置空去掉系统默认投影灰边。 -->
    <style name="PrimaryButton">
        <item name="android:background">@drawable/bg_pill_accent</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textSize">@dimen/text_title</item>
        <!-- 主按钮去掉 bold：已是青碧实心胶囊 + 52dp 高，双重强调。
             文字 normal 反而更干净。 -->
        <item name="android:textAllCaps">false</item>
        <!-- letterSpacing 删除：它的设计意图是给拉丁字母加呼吸感。
             中文字面加字距会破坏紧凑感，在 16sp 主按钮上尤其明显。
             中文界面设 letterSpacing 属于把西文排版规则套到汉字上。 -->
        <item name="android:minHeight">@dimen/control_height_lg</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingLeft">@dimen/space_5</item>
        <item name="android:paddingRight">@dimen/space_5</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 次要操作：白底 + 细边框圆角。 -->
    <style name="SecondaryButton">
        <item name="android:background">@drawable/bg_outline_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/control_height_md</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingLeft">@dimen/space_4</item>
        <item name="android:paddingRight">@dimen/space_4</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 危险操作（解除互信）：白底红字，视觉上与普通次要操作区分。 -->
    <style name="DangerButton" parent="SecondaryButton">
        <item name="android:textColor">@color/danger</item>
    </style>

    <!-- 文字按钮：无底色，仅文字色。
         触控目标：现状 13sp 文字 + 左右 10dp → 高度约 20dp，远低于 Android
         规范的 48dp（审计实测 11 处控件不达标，这是根源之一）。补 minHeight/
         minWidth + gravity=center。用 includeFontPadding=false 让 48dp 内的
         文字真正垂直居中。 -->
    <style name="TextButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/accent_on_tint</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">@dimen/touch_target_min</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingLeft">@dimen/space_3</item>
        <item name="android:paddingRight">@dimen/space_3</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/space_4</item>
    </style>

    <!-- 区块标题：一级标题 20sp、二级 16sp，统一墨色，层级靠字号与留白。 -->
    <style name="SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardBody">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <!-- 中文正文行距要比拉丁宽：汉字无升降部但字面率高、笔画密。
             1.3 是中文界面的舒适起点。 -->
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- 底部导航项：图标文字竖排，选中用品牌色。 -->
    <style name="NavItem">
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
