<?xml version="1.0" encoding="utf-8"?>
<!-- 按钮与卡片样式；主题本体在 themes.xml（两者不重复定义）。 -->
<resources>
    <!-- 主 CTA：白胶囊（置于墨色 hero 卡上）。stateListAnimator 置空去掉系统默认投影灰边。 -->
    <style name="PrimaryButton">
        <item name="android:background">@drawable/bg_pill_white</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 次要操作：白底圆角，无边框、无投影。 -->
    <style name="SecondaryButton">
        <item name="android:background">@drawable/bg_ghost_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 文字按钮：无底色，仅墨色文字。 -->
    <style name="TextButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
    </style>
</resources>
