    <string name="trust_title">互信管理</string>
    <string name="trust_note">解除后，这台电脑的凭据会从本机删除；再次连接需重新扫码。其它已配对电脑不受影响。</string>
    <string name="action_unpair_active">解除当前电脑的互信</string>
    <string name="unpair_none_title">还没有配对电脑</string>

