    <string name="app_name">MirrorDock 伴侣</string>
    <string name="app_tagline">与电脑建立加密连接，画面与文件只经过同一 Wi-Fi。</string>
    <string name="scan_hint">将相机对准电脑上的配对二维码</string>
    <string name="status_idle">未连接电脑</string>

