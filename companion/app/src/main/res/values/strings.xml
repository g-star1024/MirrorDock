    <string name="action_notify_mirror_off">关闭通知镜像</string>
    <string name="notify_mirror_status_off">已关闭。</string>
    <string name="notify_mirror_status_on">已开启：连接电脑后，新通知将实时转发。</string>
    <string name="notify_mirror_status_need_permission">已开启，但还没有「读取通知」权限：点下面的按钮到系统设置允许 MirrorDock 读取通知。</string>
    <string name="action_grant_listener">授予通知读取权限</string>
    <string name="notify_mirror_toast_need_permission">已开启通知镜像；还需要在系统设置里允许读取通知。</string>
