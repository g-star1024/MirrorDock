<?xml version="1.0" encoding="utf-8"?>
<!--
  X10-73 主界面：三 Tab（设备 / 文件 / 设置）+ 设备中心首页。

  为什么改结构（不是改配色）：单 Activity 竖向长滚在功能增多后必然拥挤——
  配对、文件、通知镜像、崩溃、日志全挤在一屏，用户找不到入口。新结构按
  ToDesk 的信息架构切成三页：设备页是「我的设备」中心，文件与设置各自独立。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg">

    <!-- ============ 设备 Tab（默认页） ============ -->
    <FrameLayout
        android:id="@+id/page_devices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/screen_padding_h"
                android:paddingRight="@dimen/screen_padding_h"
                android:paddingTop="@dimen/space_6"
                android:paddingBottom="@dimen/screen_padding_bottom">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/CardBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/app_tagline" />

                <!-- 连接状态主卡：取代旧版墨色 hero，改为白卡 + 品牌色左条。 -->
                <LinearLayout
                    android:id="@+id/status_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:background="@drawable/bg_status_card"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/screen_padding_h"
                    android:paddingRight="@dimen/screen_padding_h"
                    android:paddingTop="@dimen/space_4"
                    android:paddingBottom="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/status_dot"
                            android:layout_width="@dimen/status_dot_size"
                            android:layout_height="@dimen/status_dot_size"
                            android:background="@drawable/bg_dot" />

                        <TextView
                            android:id="@+id/status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/space_2"
                            android:text="@string/status_idle"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- X10-73 连接质量面板：延迟 / 已连接时长 / 加密直连。
                         采样不到时显示「—」，不显示 0（0 会被读成"极快"）。 -->
                    <LinearLayout
                        android:id="@+id/quality_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/quality_rtt"
                            style="@style/CardBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/quality_duration"
                            style="@style/CardBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/space_4" />

                        <TextView
                            style="@style/CardBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/space_4"
                            android:text="@string/quality_encrypted" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/button_link_start"
                        style="@style/PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/control_height_lg"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/action_link_start" />

                    <Button
                        android:id="@+id/button_link_stop"
                        style="@style/SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginTop="@dimen/space_2"
                        android:visibility="gone"
                        android:text="@string/action_link_stop" />
                </LinearLayout>

                <!-- 我的设备（X10-73）：多设备列表 + 分组筛选。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/my_devices" />

                        <Button
                            android:id="@+id/button_manage_groups"
                            style="@style/TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_manage_groups" />
                    </LinearLayout>

                    <!-- 分组筛选 chips：横向滚动，空列表时不占位。 -->
                    <HorizontalScrollView
                        android:id="@+id/group_filter_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:scrollbars="none"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/group_filter_row"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:id="@+id/device_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="vertical" />

                    <!-- 空状态：没配对过电脑时显示，如实说明怎么开始。 -->
                    <LinearLayout
                        android:id="@+id/device_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/space_6"
                        android:paddingBottom="@dimen/space_6">

                        <TextView
                            style="@style/CardBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/devices_empty" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 配对入口卡：扫码为主、手动为辅（TV 模式下自动只留手动）。 -->
                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/button_scan"
                        style="@style/PrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/control_height_lg"
                        android:text="@string/action_scan" />

                    <Button
                        android:id="@+id/button_manual"
                        style="@style/SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/action_manual" />

                    <!-- 手动输入（默认隐藏）：点「手动输入」展开即聚焦弹键盘。
                         TV 模式下默认可见并展开（电视没有相机，手动是唯一路径）。 -->
                    <EditText
                        android:id="@+id/manual_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:autofillHints="none"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/manual_hint"
                        android:imeOptions="actionGo"
                        android:inputType="text"
                        android:maxLines="1"
                        android:padding="@dimen/space_4"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="@dimen/text_label"
                        android:visibility="gone" />

                    <TextView
                        style="@style/CardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/pair_note" />

                    <!-- X10-73：把「连接上次配对的电脑」钉到桌面，点一下就连上。
                         需系统弹窗由用户确认，不会静默出现在桌面。 -->
                    <Button
                        android:id="@+id/button_pin_shortcut"
                        style="@style/SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/action_pin_shortcut" />
                </LinearLayout>

                <!-- 崩溃取证卡：只在确实发生过崩溃时出现，可查看详情、可清除。 -->
                <LinearLayout
                    android:id="@+id/crash_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:background="@drawable/bg_danger_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/crash_title"
                        android:textColor="@color/danger_text"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/crash_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:padding="@dimen/space_3"
                        android:textColor="@color/danger_text"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/button_crash_view"
                            style="@style/SecondaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/control_height_md"
                            android:text="@string/action_view_detail" />

                        <Button
                            android:id="@+id/button_crash_clear"
                            style="@style/SecondaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/control_height_md"
                            android:layout_marginLeft="@dimen/space_2"
                            android:text="@string/action_clear" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ============ 文件 Tab ============ -->
    <FrameLayout
        android:id="@+id/page_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/screen_padding_h"
                android:paddingRight="@dimen/screen_padding_h"
                android:paddingTop="@dimen/space_6"
                android:paddingBottom="@dimen/screen_padding_bottom">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/files_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button_send_to_pc"
                        style="@style/PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_weight="1"
                        android:text="@string/action_send_to_pc" />

                    <Button
                        android:id="@+id/button_files_refresh"
                        style="@style/SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginLeft="@dimen/space_2"
                        android:text="@string/action_refresh" />
                </LinearLayout>

                <TextView
                    style="@style/CardBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/files_note" />

                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/file_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- 空状态 / 需要权限：居中、留白。 -->
                    <LinearLayout
                        android:id="@+id/file_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/space_8"
                        android:paddingBottom="@dimen/space_8">

                        <TextView
                            android:id="@+id/file_empty_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/files_empty"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_body" />

                        <Button
                            android:id="@+id/button_grant_files"
                            style="@style/SecondaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/control_height_md"
                            android:layout_marginTop="@dimen/space_3"
                            android:visibility="gone"
                            android:text="@string/action_grant_files" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ============ 设置 Tab ============ -->
    <FrameLayout
        android:id="@+id/page_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="@dimen/screen_padding_h"
                android:paddingRight="@dimen/screen_padding_h"
                android:paddingTop="@dimen/space_6"
                android:paddingBottom="@dimen/screen_padding_bottom">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title" />

                <!-- 通知镜像（X10-66 一期）：三态如实反映，默认关。 -->
                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/notify_mirror_title" />

                        <Button
                            android:id="@+id/button_notify_mirror"
                            style="@style/SecondaryButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/control_height_md"
                            android:text="@string/action_notify_mirror_on" />
                    </LinearLayout>

                    <TextView
                        style="@style/CardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/notify_mirror_note" />

                    <TextView
                        android:id="@+id/notify_mirror_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <Button
                        android:id="@+id/button_grant_listener"
                        style="@style/SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginTop="@dimen/space_2"
                        android:visibility="gone"
                        android:text="@string/action_grant_listener" />
                </LinearLayout>

                <!-- 屏幕捕获授权 -->
                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capture_title" />

                    <TextView
                        style="@style/CardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/capture_note" />

                    <Button
                        android:id="@+id/button_capture"
                        style="@style/SecondaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/action_capture" />
                </LinearLayout>

                <!-- 互信管理（X10-73）：解除单台 / 全部。 -->
                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trust_title" />

                    <TextView
                        style="@style/CardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/trust_note" />

                    <Button
                        android:id="@+id/button_unpair_computer"
                        style="@style/DangerButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/control_height_md"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/action_unpair_active" />
                </LinearLayout>

                <!-- 隐私承诺 -->
                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_title" />

                    <TextView
                        style="@style/CardBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/privacy_note" />
                </LinearLayout>

                <!-- 运行日志卡：默认收起；点「查看」展开，随时可收起。 -->
                <LinearLayout
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/log_title" />

                        <Button
                            android:id="@+id/button_log_toggle"
                            style="@style/TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_show" />
                    </LinearLayout>

                    <ScrollView
                        android:id="@+id/log_scroller"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/log_scroller_height"
                        android:layout_marginTop="@dimen/space_2"
                        android:background="@drawable/bg_input"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/log_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:padding="@dimen/space_3"
                            android:textColor="@color/text_primary"
                            android:textIsSelectable="true"
                            android:textSize="@dimen/text_caption" />
                    </ScrollView>
                </LinearLayout>

                <!-- 版本信息（X10-76）：此前**整个 App 没有任何地方显示版本号**
                     （versionName 只存在于 build.gradle.kts，不进 UI）。
                     整行可点 → 展开完整信息；长按 → 复制到剪贴板
                     （小白报障的真实动作是复制粘贴，不是朗读）。 -->
                <LinearLayout
                    android:id="@+id/row_app_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_3"
                    android:paddingBottom="@dimen/space_3">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_about_title" />

                    <TextView
                        android:id="@+id/app_version_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <TextView
                    android:id="@+id/app_version_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/space_2"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />

                <!-- 隐私承诺（X10-76）：从 58 字的设置页末位提到一级页，一行说清
                     —— 这是这个产品对小白最大的转化点，他最担心的就是镜像软件偷传数据。 -->
                <TextView
                    android:id="@+id/privacy_note_short"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/space_2"
                    android:text="@string/privacy_short"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ============ 底部导航（X10-73） ============ -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_bg"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/space_3"
        android:paddingRight="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">

        <LinearLayout
            android:id="@+id/nav_devices"
            style="@style/NavItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/space_1"
            android:layout_weight="1"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <ImageView
                android:id="@+id/nav_devices_icon"
                android:layout_width="@dimen/icon_size_sm"
                android:layout_height="@dimen/icon_size_sm"
                android:contentDescription="@string/tab_devices"
                android:src="@drawable/ic_tab_devices" />

            <TextView
                android:id="@+id/nav_devices_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/tab_devices"
                android:textColor="@color/nav_unselected"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_files"
            style="@style/NavItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_1"
            android:layout_marginRight="@dimen/space_1"
            android:layout_weight="1"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <ImageView
                android:id="@+id/nav_files_icon"
                android:layout_width="@dimen/icon_size_sm"
                android:layout_height="@dimen/icon_size_sm"
                android:contentDescription="@string/tab_files"
                android:src="@drawable/ic_tab_files" />

            <TextView
                android:id="@+id/nav_files_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/tab_files"
                android:textColor="@color/nav_unselected"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            style="@style/NavItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_1"
            android:layout_weight="1"
            android:paddingTop="@dimen/space_2"
            android:paddingBottom="@dimen/space_2">

            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="@dimen/icon_size_sm"
                android:layout_height="@dimen/icon_size_sm"
                android:contentDescription="@string/tab_settings"
                android:src="@drawable/ic_tab_settings" />

            <TextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/tab_settings"
                android:textColor="@color/nav_unselected"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
