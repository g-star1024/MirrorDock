<?xml version="1.0" encoding="utf-8"?>
<!-- 电脑列表项（X10-73）：白底细边圆角，选中态用品牌色描边 + 浅青底。
     state_selected 由代码在「当前连接目标」时置位。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_tint" />
            <stroke android:width="1.5dp" android:color="@color/accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="2dp" android:color="@color/accent_bright" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg_subtle" />
            <stroke android:width="1dp" android:color="@color/input_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@color/input_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
