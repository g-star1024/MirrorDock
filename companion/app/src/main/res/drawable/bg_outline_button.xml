<?xml version="1.0" encoding="utf-8"?>
<!-- 次要操作（X10-73）：白底 + 细边框。旧版纯白底在浅灰页面上没有边界，
     层级不清；加 1dp 细边后按钮形态在白卡片与灰页面上都能被看清。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_tint" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@color/input_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
